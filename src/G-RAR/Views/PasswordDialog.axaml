<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GRAR.ViewModels"
        x:Class="GRAR.Views.PasswordDialog"
        x:DataType="vm:PasswordDialogViewModel"
        Classes="dialog"
        Title="{Binding Title}"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        KeyDown="OnKeyDown">

    <StackPanel Spacing="12" Margin="18,16">
        <Grid ColumnDefinitions="Auto,*">
            <Image Grid.Column="0"
                   Source="{StaticResource icon.password}"
                   Width="28"
                   Height="28"
                   VerticalAlignment="Top" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Message}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       LineHeight="18" />
        </Grid>

        <TextBlock Text="Password:" Classes="muted" />
        <TextBox x:Name="Password"
                 Text="{Binding Password, Mode=TwoWay}"
                 PasswordChar="●"
                 Watermark="Enter password" />

        <TextBlock Text="Repeat password:"
                   Classes="muted"
                   IsVisible="{Binding ShowConfirmation}" />
        <TextBox x:Name="PasswordAgain"
                 Text="{Binding PasswordAgain, Mode=TwoWay}"
                 PasswordChar="●"
                 Watermark="Repeat password"
                 IsVisible="{Binding ShowConfirmation}" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,6,0,0">
            <Button Content="OK"
                    IsDefault="True"
                    Classes="primary"
                    IsEnabled="{Binding ConfirmEnabled}"
                    Click="OnOk" />
            <Button Content="Cancel"
                    IsCancel="True"
                    Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>

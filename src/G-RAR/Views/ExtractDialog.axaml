<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GRAR.ViewModels"
        x:Class="GRAR.Views.ExtractDialog"
        x:DataType="vm:ExtractViewModel"
        Classes="dialog"
        Title="Extract files"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        KeyDown="OnKeyDown">

    <StackPanel Spacing="10" Margin="18,16">

        <TextBlock Classes="section" Text="DESTINATION" Margin="0,0,0,0" />

        <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0"
                     Classes="address"
                     Text="{Binding Destination, Mode=TwoWay}" />
            <Button Grid.Column="1"
                    Content="Browse…"
                    Margin="8,0,0,0"
                    Click="OnBrowse" />
        </Grid>

        <CheckBox Content="Extract files with their folder structure"
                  IsChecked="{Binding UseFolderNames}" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="If a file already exists:" VerticalAlignment="Center" />
            <ComboBox MinWidth="210"
                      ItemsSource="{Binding OverwriteNamesList}"
                      SelectedIndex="{Binding OverwriteIndex}" />
        </StackPanel>

        <CheckBox Content="Open the destination folder when finished"
                  IsChecked="{Binding OpenDestination}" />

        <TextBlock Classes="section" Text="PASSWORD" IsVisible="{Binding ShowPassword}" />
        <TextBlock Text="This archive contains encrypted entries."
                   Classes="muted"
                   IsVisible="{Binding ShowPassword}" />
        <TextBox Text="{Binding Password, Mode=TwoWay}"
                 PasswordChar="●"
                 Watermark="Password (leave empty to be asked)"
                 IsVisible="{Binding ShowPassword}" />

        <Border Classes="panel" Padding="8,6">
            <TextBlock Text="{Binding Summary}" />
        </Border>

        <TextBlock Text="{Binding ValidationError}"
                   Foreground="#FFC0392B"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasValidationError}" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,8,0,0">
            <Button Content="Extract"
                    IsDefault="True"
                    Classes="primary"
                    IsEnabled="{Binding ConfirmEnabled}"
                    Click="OnOk" />
            <Button Content="Cancel"
                    IsCancel="True"
                    Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
